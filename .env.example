NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# ID público del cliente OAuth web. Autoriza cargas directas a Google Drive.
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=
# Solo en el servidor. Permite enviar el email de invitación con Auth Admin.
SUPABASE_SECRET_KEY=
# Solo en el servidor. Administradores globales separados por comas.
TASKA_PLATFORM_ADMIN_EMAILS=

# Envío transaccional de notificaciones (solo servidor / Supabase Functions).
RESEND_API_KEY=
EMAIL_FROM=Taska <notificaciones@notificaciones.example.com>
EMAIL_DISPATCH_SECRET=

# Opcionales: habilitan `pnpm test:supabase` contra un proyecto aislado.
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_EMAIL=
SUPABASE_TEST_PASSWORD=
